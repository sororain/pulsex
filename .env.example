# AWS 凭证（必填，只需只读权限，如 ReadOnlyAccess）
AWS_ACCESS_KEY_ID=YOUR_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=YOUR_SECRET_KEY

# AWS 区域（必填，多个用逗号分隔）
AWS_REGIONS=ap-northeast-1, ap-southeast-1

# 检查间隔，单位分钟（可选，默认 1）
CHECK_INTERVAL_MIN=1

# Server酱 推送 Token（可选，留空不推送）
SERVER_CHAN_TOKEN=

# Telegram 推送（可选，两者都填才会推送）
# 通过 @BotFather 创建 Bot 获取 Token，向机器人发消息后用 getUpdates 查询 Chat ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# IP 状态文件（可选，默认 ip-state.json）
STATE_FILE=ip-state.json
